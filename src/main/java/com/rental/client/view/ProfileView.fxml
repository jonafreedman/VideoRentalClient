<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rental.client.controller.ProfileController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0f172a; -fx-padding: 12px 20px;">
         <children>
            <Label style="-fx-font-size: 20px;" text="🎬" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold;" text="Movie Rental Hub — Customer Profile" textFill="WHITE" />
         </children>
      </HBox>
      
      <VBox spacing="15.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 6, 0, 0, 2);">
               <children>
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16px;" text="👤 Account Dashboard" textFill="#1e293b" />
                        <Label fx:id="profileUserLabel" text="Active Account: customer_user_01" textFill="#64748b" />
                     </children>
                  </VBox>
                  <Button fx:id="backToCatalogButton" mnemonicParsing="false" prefHeight="32.0" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4px;" text="◀ Return to Catalog" />
               </children>
            </HBox>
            
            <Label style="-fx-font-weight: bold;" text="Your Complete Rental History Logs" textFill="#334155">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <TableView fx:id="loanHistoryTableView" style="-fx-background-radius: 6px;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="loanTitleColumn" prefWidth="280.0" text="Movie/DVD Title" />
                <TableColumn fx:id="rentDateColumn" prefWidth="140.0" text="Date Borrowed" />
                <TableColumn fx:id="returnDateColumn" prefWidth="140.0" text="Date Returned" />
                <TableColumn fx:id="loanStatusColumn" prefWidth="120.0" text="Loan Status" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>